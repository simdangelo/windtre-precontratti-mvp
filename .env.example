# ==============================================================================
    # WINDTRE Sintesi & Trasparenze Automation - Environment Configuration
# ==============================================================================

# Microsoft Graph / OneDrive API Credentials (Required for Sintesi DOCX -> PDF/UA Compilation)
# You can use either the MS_GRAPH_* prefix or the ONEDRIVE_* alias.
MS_GRAPH_TENANT_ID=your-azure-tenant-id
MS_GRAPH_CLIENT_ID=your-azure-client-id
MS_GRAPH_CLIENT_SECRET=your-azure-client-secret
MS_GRAPH_DRIVE_ID=your-onedrive-drive-id

# Optional Alternative OneDrive Aliases
# ONEDRIVE_TENANT_ID=your-azure-tenant-id
# ONEDRIVE_CLIENT_ID=your-azure-client-id
# ONEDRIVE_CLIENT_SECRET=your-azure-client-secret
# ONEDRIVE_DRIVE_ID=your-onedrive-drive-id
# ONEDRIVE_USER_ID=your-onedrive-user-id
